# Only needed when the API is NOT served from the same origin (e.g. production on another domain).
# In development Vite proxies /api to http://localhost:5000, so you can leave this empty.
VITE_API_URL=

# Walking-route service (OSRM compatible). Default is the public OpenStreetMap Germany foot router.
VITE_ROUTING_URL=

# Optional: use Google Maps instead of OpenStreetMap. Leave empty to keep OpenStreetMap (free, no card needed).
# Needs a Google Cloud project with billing and the "Maps JavaScript API" enabled.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your own Google Map ID (the default demo ID is fine for testing)
VITE_GOOGLE_MAP_ID=
